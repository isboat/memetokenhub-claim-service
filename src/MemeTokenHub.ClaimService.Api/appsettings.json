{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017/?replicaSet=rs0",
    "DatabaseName": "MemeTokenHubClaims"
  },
  "Jwt": {
    "Issuer": "MemeTokenHub",
    "Audience": "MemeTokenHub.Api",
    "SecretKey": "replace-this-development-key-with-a-secret-manager-value"
  },
  "ServiceAuthentication": {
    "BearerToken": ""
  },
  "ServiceEndpoints": {
    "UserService": "https://localhost:7101/",
    "TokenService": "https://localhost:7102/"
  },
  "Attachments": {
    "UploadBaseUrl": "https://storage.example.test/upload",
    "SigningKey": "replace-this-signing-key-with-a-secret-manager-value",
    "UploadLifetimeMinutes": 10,
    "MaximumSizeInBytes": 10485760,
    "AllowedContentTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png"
    ]
  },
  "ServiceBus": {
    "Enabled": false,
    "ConnectionString": "Endpoint=sb://localhost/;SharedAccessKeyName=development;SharedAccessKey=development",
    "TopicName": "claim-events"
  }
}
