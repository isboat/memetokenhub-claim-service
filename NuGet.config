<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="MemeTokenHub" value="https://nuget.pkg.github.com/isboat/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="AspNetCore.*" />
      <package pattern="Azure.*" />
      <package pattern="Microsoft.*" />
      <package pattern="MongoDB.*" />
      <package pattern="NUnit*" />
      <package pattern="Swashbuckle.*" />
      <package pattern="System.*" />
      <package pattern="coverlet.*" />
      <package pattern="Moq" />
    </packageSource>
    <packageSource key="MemeTokenHub">
      <package pattern="MemeTokenHub.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
